# DeployFlow Server Environment Variables
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Local default or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/deployflow

# JWT & Authentication

JWT_EXPIRES_IN=7d
JWT_SECRET=your_jwt_secret_here
COOKIE_SECRET=your_cookie_secret_here

# Admin Bootstrap Credentials (Used to seed initial admin user if not present)
# Admin Bootstrap Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_before_running
ADMIN_NAME="System Administrator"

# Rate Limiting & Usage Quotas
MAX_REQUESTS_PER_MINUTE=100
